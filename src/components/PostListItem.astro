---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../config/site";

interface Props {
  post: CollectionEntry<"blog">;
  variant?: "feature" | "list";
}

const { post, variant = "list" } = Astro.props;
---

<article class:list={["post-list-item", `post-list-item--${variant}`]}>
  <p class="post-list-item__meta">
    <time datetime={post.data.publishDate.toISOString()}>
      {post.data.publishDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </time>
  </p>

  <h2 class="post-list-item__title">
    <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
  </h2>

  {variant === "feature" ? <p class="post-list-item__summary">{post.data.summary}</p> : null}
  {variant === "feature" ? <a class="post-list-item__cta" href={withBase(`/blog/${post.id}/`)}>Read article →</a> : null}
</article>
