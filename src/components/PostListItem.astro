---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../config/site";
import { getReadingTimeMinutes } from "../utils/content";

interface Props {
  post: CollectionEntry<"blog">;
  variant?: "feature" | "list";
  showSummary?: boolean;
}

const { post, variant = "list", showSummary = false } = Astro.props;
const readingMinutes = getReadingTimeMinutes(post);
---

<article class:list={["post-list-item", `post-list-item--${variant}`]}>
  <p class="post-list-item__meta">
    <time datetime={post.data.publishDate.toISOString()}>
      {post.data.publishDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </time>
    {variant === "feature" ? ` / ${readingMinutes} min read` : null}
  </p>

  <a class="post-list-item__content-link" href={withBase(`/blog/${post.id}/`)}>
    <h2 class="post-list-item__title">{post.data.title}</h2>
    {variant === "feature" || showSummary ? <p class="post-list-item__summary">{post.data.summary}</p> : null}
  </a>

  {variant === "feature" ? <a class="post-list-item__cta" href={withBase(`/blog/${post.id}/`)}>Read article →</a> : null}
  {variant === "list" ? <p class="post-list-item__reading-time">{readingMinutes} min</p> : null}
</article>
