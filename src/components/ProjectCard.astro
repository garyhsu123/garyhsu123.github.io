---
interface LinkItem {
  label: string;
  url: string;
}

interface Project {
  title: string;
  context: string;
  links: LinkItem[];
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <h3 class="project-card__title">
    <span class="project-card__prompt" aria-hidden="true">&gt;</span>
    {project.title}
  </h3>
  <p>{project.context}</p>
  <div class="project-card__links">
    {
      project.links.map((link) => (
        <a href={link.url} rel="noreferrer" target="_blank">
          {link.label} ↗
        </a>
      ))
    }
  </div>
</article>
