---
interface LinkItem {
  label: string;
  url: string;
}

interface Project {
  title: string;
  context: string;
  image?: string;
  accent?: string;
  links: LinkItem[];
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const initials = project.title
  .split(" ")
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? "")
  .join("");
---

<article class:list={["project-card", `project-card--${project.accent ?? "slate"}`]}>
  <div class="project-card__visual" aria-hidden="true">
    {project.image ? <img alt="" loading="lazy" src={project.image} /> : <span>{initials}</span>}
  </div>

  <div class="project-card__body">
    <h3>{project.title}</h3>
    <p>{project.context}</p>
    <div class="project-card__links">
      {
        project.links.map((link) => (
          <a href={link.url} rel="noreferrer" target="_blank">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</article>
