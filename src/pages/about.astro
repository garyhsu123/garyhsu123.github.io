---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const profile = await getEntry("about", "profile");

if (!profile) {
  throw new Error("About profile entry is required.");
}

const sections = [
  { id: "intro", label: "Intro" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "education", label: "Education" },
  { id: "skills", label: "Skills" },
  { id: "links", label: "Links" },
];
const skillItems = profile.data.skills.flatMap((group) => group.items);
---

<BaseLayout description="About Gary Hsu, selected work, experience, education, and skills." path="/about" title="About">
  <section class="shell about-layout">
    <aside class="about-sidebar">
      <p class="eyebrow">Sections</p>
      <nav aria-label="About sections">
        <ul class="about-sidebar__nav">
          {
            sections.map((section, index) => (
              <li>
                <a
                  class:list={[{ "is-current": index === 0 }]}
                  data-section-link={section.id}
                  href={`#${section.id}`}
                >
                  {section.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <div class="about-content">
      <section class="about-block" id="intro">
        <p class="eyebrow">About</p>
        <h1>{profile.data.name}</h1>
        <div class="about-copy">
          <p>{profile.data.intro.summary}</p>
          <p>
            I care most about systems that stay predictable under pressure and tools that make other engineers faster.
            I write here to think in public and keep my reasoning honest.
          </p>
        </div>
      </section>

      <section class="about-block" id="experience">
        <p class="eyebrow">Experience</p>
        <div class="stack-list">
          {
            profile.data.experience.map((item) => (
              <article class="timeline-item timeline-item--about">
                <p class="timeline-item__period">{item.period}</p>
                <div class="timeline-item__body">
                  <h3>{item.role} · {item.company}</h3>
                  <p>{item.summary}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-block" id="projects">
        <p class="eyebrow">Curated projects</p>
        <div class="project-grid">
          {profile.data.projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>

      <section class="about-block" id="education">
        <p class="eyebrow">Education</p>
        <div class="stack-list">
          {
            profile.data.education.map((item) => (
              <article class="timeline-item timeline-item--about">
                <p class="timeline-item__period">{item.period}</p>
                <div class="timeline-item__body">
                  <h3>{item.program}</h3>
                  <p>{item.school}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-block" id="skills">
        <p class="eyebrow">Skills</p>
        <div class="skills-cloud">
          {skillItems.map((item) => <span class="skill-chip">{item}</span>)}
        </div>
      </section>

      <section class="about-block" id="links">
        <p class="eyebrow">Links</p>
        <div class="social-list">
          {
            profile.data.socialLinks.map((link) => (
              <a href={link.url} rel="noreferrer" target="_blank">
                {link.label}
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>

  <script>
    const sectionLinks = Array.from(document.querySelectorAll("[data-section-link]"));
    const sections = sectionLinks
      .map((link) => {
        const id = link.getAttribute("data-section-link");
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    if (sectionLinks.length > 0 && sections.length > 0) {
      let lockedSectionId = null;
      let scrollEndTimer;
      let scrollFrame;

      const getScrollOffset = () => {
        const header = document.querySelector(".site-header");
        const headerHeight = header?.getBoundingClientRect().height ?? 0;

        return headerHeight + 32;
      };

      const setActiveLink = (activeId) => {
        sectionLinks.forEach((link) => {
          link.classList.toggle("is-current", link.getAttribute("data-section-link") === activeId);
        });
      };

      const clearLock = () => {
        lockedSectionId = null;
        window.clearTimeout(scrollEndTimer);
        updateActiveSection();
      };

      const updateActiveSection = () => {
        if (lockedSectionId) {
          setActiveLink(lockedSectionId);
          return;
        }

        const offset = getScrollOffset();
        const isAtPageEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        const currentSection = isAtPageEnd
          ? sections.at(-1)
          : sections.findLast((section) => section.getBoundingClientRect().top - offset <= 2) ?? sections[0];

        if (currentSection?.id) {
          setActiveLink(currentSection.id);
        }
      };

      const scheduleScrollEnd = () => {
        window.clearTimeout(scrollEndTimer);
        scrollEndTimer = window.setTimeout(clearLock, 140);
      };

      const handleScroll = () => {
        window.cancelAnimationFrame(scrollFrame);
        scrollFrame = window.requestAnimationFrame(updateActiveSection);

        if (lockedSectionId) {
          scheduleScrollEnd();
        }
      };

      sectionLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          const activeId = link.getAttribute("data-section-link");
          const targetSection = activeId ? document.getElementById(activeId) : null;

          if (activeId && targetSection) {
            event.preventDefault();
            lockedSectionId = activeId;
            setActiveLink(activeId);
            window.history.replaceState(null, "", `#${activeId}`);

            const targetTop = targetSection.getBoundingClientRect().top + window.scrollY - getScrollOffset();
            window.scrollTo({
              top: Math.max(0, targetTop),
              behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
            });
            scheduleScrollEnd();
          }
        });
      });

      updateActiveSection();
      window.addEventListener("scroll", handleScroll, { passive: true });
      window.addEventListener("scrollend", () => {
        if (lockedSectionId) {
          clearLock();
        }
      });
      window.addEventListener("wheel", clearLock, { passive: true });
      window.addEventListener("touchstart", clearLock, { passive: true });
    }
  </script>
</BaseLayout>
