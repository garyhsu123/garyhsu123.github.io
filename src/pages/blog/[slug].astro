---
import { render, type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../config/site";
import { getPublishedPosts, getReadingTimeMinutes, isPublishedPost } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const showToc = headings.length >= 3;
const allPosts = await getCollection("blog");
const posts = allPosts.filter(isPublishedPost).sort((left, right) => {
  return right.data.publishDate.getTime() - left.data.publishDate.getTime();
});
const currentIndex = posts.findIndex((item) => item.id === post.id);
const previousPost = posts[currentIndex + 1];
const nextPost = posts[currentIndex - 1];
const readingTime = getReadingTimeMinutes(post);
---

<BaseLayout
  description={post.data.summary}
  ogType="article"
  path={`/blog/${post.id}/`}
  title={post.data.title}
>
  <section class="shell article-shell">
    <a class="article-back-link" href={withBase("/blog")}>← All posts</a>

    <div class="article-shell__header">
      <p class="article-shell__meta">
        <time datetime={post.data.publishDate.toISOString()}>
          {post.data.publishDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        <span aria-hidden="true">/</span>
        <span>{readingTime} min read</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="article-shell__summary">{post.data.summary}</p>
    </div>

    <div class="article-layout">
      <article class="article-prose">
        <Content />
      </article>

      {
        showToc ? (
          <aside class="article-toc" aria-label="Table of contents">
            <p class="article-toc__title">On this page</p>
            <ul>
              {headings.map((heading, index) => (
                <li>
                  <a
                    class:list={[{ "is-current": index === 0 }]}
                    data-toc-link={heading.slug}
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        ) : null
      }
    </div>

    <section class="author-panel">
      <div>
        <p class="eyebrow">Author context</p>
        <h2>Why this site exists</h2>
      </div>
      <p>
        I use writing to clarify technical tradeoffs, document implementation thinking, and share practical ideas that
        other builders can reuse.
      </p>
      <a class="text-link" href={withBase("/about")}>More about me</a>
    </section>

    <nav class="article-pagination" aria-label="Article navigation">
      {previousPost ? <a href={withBase(`/blog/${previousPost.id}/`)}>← {previousPost.data.title}</a> : <span />}
      {nextPost ? <a href={withBase(`/blog/${nextPost.id}/`)}>{nextPost.data.title} →</a> : <span />}
    </nav>
  </section>

  <script>
    const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));
    const articleSections = tocLinks
      .map((link) => {
        const id = link.getAttribute("data-toc-link");
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    if (tocLinks.length > 0 && articleSections.length > 0) {
      let lockedSectionId = null;
      let scrollEndTimer;
      let scrollFrame;

      const getScrollOffset = () => {
        const header = document.querySelector(".site-header");
        return (header?.getBoundingClientRect().height ?? 0) + 32;
      };

      const setActiveLink = (activeId) => {
        tocLinks.forEach((link) => {
          const isCurrent = link.getAttribute("data-toc-link") === activeId;
          link.classList.toggle("is-current", isCurrent);
          if (isCurrent) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const updateActiveSection = () => {
        if (lockedSectionId) {
          setActiveLink(lockedSectionId);
          return;
        }

        const offset = getScrollOffset();
        const isAtPageEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        const currentSection = isAtPageEnd
          ? articleSections.at(-1)
          : articleSections.findLast((section) => section.getBoundingClientRect().top - offset <= 2) ??
            articleSections[0];

        if (currentSection?.id) {
          setActiveLink(currentSection.id);
        }
      };

      const clearLock = () => {
        lockedSectionId = null;
        window.clearTimeout(scrollEndTimer);
        updateActiveSection();
      };

      const scheduleScrollEnd = () => {
        window.clearTimeout(scrollEndTimer);
        scrollEndTimer = window.setTimeout(clearLock, 140);
      };

      const handleScroll = () => {
        window.cancelAnimationFrame(scrollFrame);
        scrollFrame = window.requestAnimationFrame(updateActiveSection);
        if (lockedSectionId) scheduleScrollEnd();
      };

      tocLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          const activeId = link.getAttribute("data-toc-link");
          const targetSection = activeId ? document.getElementById(activeId) : null;

          if (!activeId || !targetSection) return;

          event.preventDefault();
          lockedSectionId = activeId;
          setActiveLink(activeId);
          window.history.replaceState(null, "", `#${activeId}`);

          const targetTop = targetSection.getBoundingClientRect().top + window.scrollY - getScrollOffset();
          window.scrollTo({
            top: Math.max(0, targetTop),
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          });
          scheduleScrollEnd();
        });
      });

      updateActiveSection();
      window.addEventListener("scroll", handleScroll, { passive: true });
      window.addEventListener("scrollend", () => {
        if (lockedSectionId) clearLock();
      });
      window.addEventListener("wheel", clearLock, { passive: true });
      window.addEventListener("touchstart", clearLock, { passive: true });
    }
  </script>
</BaseLayout>
