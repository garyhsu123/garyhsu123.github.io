---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostListItem from "../components/PostListItem.astro";
import { SITE_DESCRIPTION, SITE_TAGLINE, withBase } from "../config/site";
import { getPublishedPosts } from "../utils/content";

const posts = await getPublishedPosts();
const latestPost = posts[0];
const morePosts = posts.slice(1, 4);
const profile = await getEntry("about", "profile");
const intro = profile?.data.intro;
const socialLinks = profile?.data.socialLinks ?? [];
---

<BaseLayout description={SITE_DESCRIPTION} path="/" title="Home">
  <section class="hero shell home-section home-section--intro">
    <p class="eyebrow">{profile?.data.role ?? "Software Engineer"}</p>
    <h1>{intro?.headline ?? SITE_TAGLINE}</h1>
    <p class="hero__summary">
      {intro?.summary ??
        "A small site for practical software writing, implementation tradeoffs, and lessons from building."}
    </p>
    <div class="hero__links">
      <a class="hero__primary-link" href={withBase("/about")}>More about me</a>
      {
        socialLinks.map((link) => (
          <a href={link.url} rel="noreferrer" target="_blank">
            {link.label} ↗
          </a>
        ))
      }
    </div>
  </section>

  <section class="shell section-stack home-section">
    <div class="section-heading">
      <p class="eyebrow">Latest article</p>
      <a class="text-link" href={withBase("/blog")}>All posts →</a>
    </div>

    {
      latestPost ? (
        <PostListItem post={latestPost} variant="feature" />
      ) : (
        <article class="empty-panel">
          <p>Articles are on the way. The archive is still small, but new technical notes will appear here soon.</p>
        </article>
      )
    }
  </section>

  {
    morePosts.length > 0 ? (
      <section class="shell section-stack">
        <div class="section-heading">
          <p class="eyebrow">More writing</p>
        </div>
        <div class="post-list">
          {morePosts.map((post) => <PostListItem post={post} variant="list" />)}
        </div>
      </section>
    ) : null
  }
</BaseLayout>
